## Step 1: Provisioning the Initial EC2 Instance

I defined an Ubuntu AMI data source and an EC2 instance (`aws_instance.ex1`) inside `resou.tf`:

### `resou.tf`

```hcl
data "aws_ami" "own_ami_ubuntu_IND" {
  most_recent = true
  owners      = ["099720109477"] # Canonical's AWS account ID

  filter {
    name   = "name"
    values = ["ubuntu/images/hvm-ssd/ubuntu-jammy-22.04-amd64-server-*"]
  }

  filter {
    name   = "virtualization-type"
    values = ["hvm"]
  }
}

resource "aws_instance" "ex1" {
  ami           = data.aws_ami.own_ami_ubuntu_IND.id
  instance_type = "t2.micro"

  tags = {
    Name = "own-tera-instance"
