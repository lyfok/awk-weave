## Project Configuration

### 1. `terra.tf` (Provider Setup)

```hcl
terraform {
  required_providers {
    # Specifying provider requirements and constraints
    aws = {
      source  = "hashicorp/aws"
      version = ">= 6.42.0"
    }

    random = {
      source  = "hashicorp/random"
      version = "3.8.1"
    }
  }
}

# Regional AWS provider config initialized with an alias block
provider "aws" {
  region = "ap-south-1"
  alias  = "ubuntu_IND"
}

```

### 2. `ec2-resou.tf` (EC2 Resource Definition)

```hcl
data "aws_ami" "own_ami_ubuntu_IND" {
  most_recent = true
  owners      = ["099720109477"] # Canonical official owner ID
  provider    = aws.ubuntu_IND   # Mapping to explicit regional provider alias

  filter {
    name   = "name"
    values = ["ubuntu/images/hvm-ssd/ubuntu-jammy-22.04-amd64-server-*"]
  }

  filter {
    name   = "virtualization-type"
    values = ["hvm"]
  }
}

locals {
  different_instance_type={
    urban   = "t3.micro"
    village = "t2.small"
  }
}

resource "aws_instance" "my_instan" {
  ami           = data.aws_ami.own_ami_ubuntu_IND.id
  #instance_type = "t2.micro"
  #instance_type  = terraform.workspace == "urban" ? "t3.medium" : "t2.micro"
  instance_type = lookup(local.different_instance_type, terraform.workspace, "t2.micro")

  tags = {
    Name = "ec2_life_${terraform.workspace}"
  }
}

```

---

## How Environment Sizing Works

| Workspace | Instance Type | Tag Name |
| --- | --- | --- |
| **`urban`** | `t3.micro` | `ec2_life_urban` |
| **`village`** | `t2.small` | `ec2_life_village` |
| **`default` / other** | `t2.micro` *(fallback)* | `ec2_life_default` |

