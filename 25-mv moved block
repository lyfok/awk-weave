# Provider Configuration

```hcl
terraform {
  required_providers {

    aws = {
      source  = "hashicorp/aws"
      version = ">= 6.42.0"
    }

    random = {
      source  = "hashicorp/random"
      version = "3.8.1"
    }

  }
}

provider "aws" {
  region = "ap-south-1"
  alias  = "ubuntu_IND"
}
```

---

# EC2 Configuration

I used the following resource throughout the exercise.

```hcl
locals {
  instances_names = [
    "car",
    "villa"
  ]
}

resource "aws_instance" "my_new_instan" {

  for_each = toset(local.instances_names)

  # count = 2

  ami           = data.aws_ami.own_ami_ubuntu_IND.id
  instance_type = "t3.micro"

  tags = {
    Name = "village_life_${each.key}"

    # Name = "village_life"
  }

}
```

